## Usage

```python
from connector import {{ class_name }}, SourceClient, DestinationClient

# Full sync: read from {{ source_system }}, write to {{ destination_system }}
connector = {{ class_name }}(
    src_token="your-{{ source_system | lower }}-token",
    dst_token="your-{{ destination_system | lower }}-token",
)
synced = connector.sync_{{ entity_name }}s()
print(f"Synced {synced} {{ entity_name }}(s)")

# Direct source access
source = SourceClient(api_token="your-{{ source_system | lower }}-token")
records = source.list_{{ entity_name }}s()
record = source.get_{{ entity_name }}("record-id")

# Direct destination access
destination = DestinationClient(api_token="your-{{ destination_system | lower }}-token")
new_record = destination.create_{{ entity_name }}({"field": "value"})
destination.update_{{ entity_name }}("record-id", {"field": "new-value"})
```

